# Base URL of the FHIR server this app talks to.
#
# Default: the included zero-dependency demo backend (run `npm run server`).
VITE_FHIR_BASE_URL=http://localhost:3001/fhir
#
# When you're ready to move off the demo backend, point this at a real HAPI FHIR
# server instead — e.g. deployed per the README (ALB in front of an ECS HAPI FHIR JPA
# server): VITE_FHIR_BASE_URL=https://fhir.your-domain.com/fhir
# or a local HAPI FHIR docker instance: VITE_FHIR_BASE_URL=http://localhost:8080/fhir

# OAuth2 token endpoint / bearer token source for the FHIR server, if secured.
# Leave blank to call the FHIR server unauthenticated (dev only).
VITE_FHIR_AUTH_TOKEN=

# App-level "clinic" tenant identifier, sent as a custom header (X-Tenant-Id) if your
# HAPI FHIR server is running in multi-tenant partition mode.
VITE_TENANT_ID=default

# Polling interval (ms) for the background local->server sync worker.
VITE_SYNC_INTERVAL_MS=15000
