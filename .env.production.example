# Copy to .env on the server (never commit the real one). docker compose reads .env
# automatically from the same directory as docker-compose.yml.

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Your real domain, e.g. app.daoval.com — Caddy will get a TLS cert for this automatically.
# DNS A record must point at the VM's Elastic IP before you start the stack, or
# Let's Encrypt's HTTP challenge will fail.
DOMAIN=

# Once DOMAIN is TLS-protected, the frontend and API share an origin, so this can be
# locked to the real domain instead of *.
# Only matters for cross-origin setups (e.g. local `npm run dev`, where the Vite dev
# server on :5173 calls the backend on :3001). In this deployment, frontend and
# backend are served from the same origin via Caddy, so browsers never apply CORS to
# these requests at all — this value is effectively unused in production here, but
# should still match your real domain for correctness/defense-in-depth.
ALLOWED_ORIGIN=https://daoval.duckdns.org

VITE_TENANT_ID=default

# Required. Generate with: openssl rand -base64 48
# Signs session cookies — changing this logs everyone out.
JWT_SECRET=

# Leave blank until email sending is set up (see DEPLOYMENT.md — Brevo's free tier,
# 300 emails/day forever, no card required, is the recommended option). While blank,
# NODE_ENV should stay "development" below so MFA codes print to
# `docker compose logs backend` instead of failing to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# development: MFA codes are logged, not emailed. production: requires SMTP_HOST and
# SMTP_FROM to be set, or logins will fail.
NODE_ENV=development
